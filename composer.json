{
    "name": "vmt/payfast",
    "description": "Isolated, auditable PayFast hosted one-time payments for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/encryption": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {"psr-4": {"Vmt\\PayFast\\": "src/"}},
    "autoload-dev": {"psr-4": {"Vmt\\PayFast\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Vmt\\PayFast\\Providers\\PayFastServiceProvider"]}},
    "scripts": {"test": "phpunit", "format": "pint", "check": ["@test", "pint --test"]},
    "config": {"sort-packages": true}
}
